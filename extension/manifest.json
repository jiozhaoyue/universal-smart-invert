{
  "manifest_version": 3,
  "name": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
  "version": "4.1.0",
  "description": "全网通用智能视频与图片反色脚本 (v4.1, AGPL-3.0 开源)。新增: 字体覆盖与文字描边 (Dark Reader 同款无障碍能力, 热生效); 保留 v4.0 电源热生效/双页签/三态能力卡片与 v3.x 全部引擎能力。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
