{
  "manifest_version": 3,
  "name": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
  "version": "5.0.0",
  "description": "全网通用智能视频与图片反色脚本 (v5.0, AGPL-3.0 开源)。v5.0 把插件扩为「页面媒体治理层」: 统一元素动作表 (invert/keep/hide/mask/dim/peek) 经单一来源表与写点仲裁解析; 新增元素屏蔽",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
