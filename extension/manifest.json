{
  "manifest_version": 3,
  "name": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
  "version": "4.0.0",
  "description": "全网通用智能视频与图片反色脚本 (v4.0)。新增: 设置页推倒重做 (电源横幅热生效 + 本站/全局双页签 + 三态能力卡片, 零冗余), 本站电源/站点名单热切换 (立即拆除全部反色, 无需刷新); 保留 v3.x 全部引擎能力。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
