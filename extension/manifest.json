{
  "manifest_version": 3,
  "name": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
  "version": "3.3.0",
  "description": "全网通用智能视频与图片反色脚本 (v3.3)。新增: 设置面板全面改版 (居中/靠左/靠右三种布局可停靠, 信息架构重排, 界面全中文化, 规则文件导出导入, 元素级规则); 保留 v3.2 视频画面调节与 v3.1/v3.0 全部能力。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
