{
  "manifest_version": 3,
  "name": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
  "version": "4.5.0",
  "description": "全网通用智能视频与图片反色脚本 (v4.5, AGPL-3.0 开源)。新增: Dark Reader 式工具栏弹窗面板, 设置行回显修复 (悬停显示原图开关真实生效), 零白交接防闪光 (深色站点黑→深色绝不闪白), 规则分发 (从链接导入 / 导出学习成果",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "全网通用智能视频与图片反色 (Universal Smart Video & Image Invert)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
