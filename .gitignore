# Trellis runtime and local developer configs
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
.trellis/.ralph-state.json
.trellis/*.tmp
.trellis/*.new
.trellis/**/__pycache__/
.trellis/**/*.pyc

# Node / OS / Test
node_modules/
.DS_Store
Thumbs.db
.chrome-test-profile/

# Build artifacts (generated by scripts/build-extension.js + scripts/pack.js; never commit)
dist/

# AI & Editor Platform directories (Excluded from git tracking)
# NOTE: .github/workflows/ (CI + release pipelines) must stay committable —
# ignore .github contents but re-include the workflows directory.
.agent/
.agents/
.claude/
.codebuddy/
.codex/
.cursor/
.devin/
.dsh/
.factory/
.gemini/
.github/*
!/.github/workflows/
.grok/
.kilocode/
.kimi-code/
.kiro/
.omp/
.opencode/
.pi/
.qoder/
.reasonix/
.snow/
.trae/
.zcode/

# Local visual-test screenshots (generated by scripts/visual-probe.js)
dev/shots/

# Local verdict fixtures (generated by scripts/export-fixtures.js from the user's own
# exported backup). Contains the user's own image URLs → personal data, never committed.
dev/fixtures/

# Parallel-agent git worktrees (one per dispatched worker)
.worktrees/

# VS Code local history
.history/

# v6.5 签名私钥与 CRX 产物 (公开仓硬约束: 私钥绝不入库)
*.pem
crx-private-key.pem
*.crx
